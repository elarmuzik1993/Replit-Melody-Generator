language = "nodejs"
run = "npm run build && npm start"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]
modules = ["nodejs-20"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]

[[workflows.workflow]]
name = "Start application"
mode = "sequential"
author = 47517815

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
